# OpenIPC Bonnet buttons for the U-Boot boot menu (see /boot/uboot-menu.env).
# U-Boot pin names: bank d = gpiochip3. up=PIN_16 down=PIN_18 select=right=PIN_12
# NOTE: PIN_12 -> GPIO3_A5 (d5) derived from the Radxa Zero 3 pinout table,
# not yet verified on hardware (gpiofind PIN_12).
btn_up=d9
btn_dn=d10
btn_ok=d5
