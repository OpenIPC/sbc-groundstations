# U-Boot GPIO boot menu (generic logic, all boards).
# Imported by CONFIG_PREBOOT together with the per-board /boot/uboot-buttons.env,
# which defines btn_up / btn_dn / btn_ok (U-Boot pin names, e.g. d9 = gpiochip3 line 9).
# Without a buttons file the preboot_hook does nothing.
# Plain-text env format: one variable per line (no line continuation).
menu_draw=setenv stdout serial,vidconsole; cls; echo; echo "  ===== BOOT MENU ====="; if test "$msel" = "0"; then echo "  ==> Normal boot"; echo "      Verbose boot"; else echo "      Normal boot"; echo "  ==> Verbose boot"; fi; echo "  UP/DOWN select - RIGHT boot"; setenv stdout serial
bootmenu_gpio=setenv msel 0; setenv mlast x; setenv mdone 0; setenv stdout serial; while test "$mdone" = "0"; do if test "$msel" != "$mlast"; then setenv mlast $msel; run menu_draw; fi; gpio read gup $btn_up; gpio read gdn $btn_dn; gpio read gok $btn_ok; if test "$gup" = "1"; then setenv msel 0; fi; if test "$gdn" = "1"; then setenv msel 1; fi; if test "$gok" = "1"; then setenv mdone 1; fi; sleep 0.1; done; setenv stdout serial,vidconsole; if test "$msel" = "1"; then echo "Booting VERBOSE ..."; setenv pxe_label_override verbose; else echo "Booting normal ..."; fi; setenv mdone; setenv mlast; setenv gup; setenv gdn; setenv gok
preboot_hook=if env exists btn_up; then gpio read menukey $btn_up; if test x$menukey = x1; then setenv stdout serial,vidconsole; setenv stderr serial,vidconsole; run bootmenu_gpio; fi; fi
